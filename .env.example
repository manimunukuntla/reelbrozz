# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_WEBHOOK_URL: Server-side Google Apps Script Web App URL.
# Keep this ONLY in server secrets so it is never exposed in frontend code.
GOOGLE_SHEETS_WEBHOOK_URL=""

# GOOGLE_SHEETS_SECRET: Shared secret token verified by your Apps Script doPost/doGet.
# Generate a random 32+ character string and set the exact same value in Apps Script Properties.
GOOGLE_SHEETS_SECRET=""
